# Prismarine Environment Configuration Template
# COPY THIS FILE TO .env AND GENERATE YOUR OWN CRYPTOGRAPHIC SECRETS!
# DO NOT COMMIT .env TO VERSION CONTROL.

# Application Configuration
APP_ENV=production
DEMO_MODE=false
PORT=8000
HOST=0.0.0.0

# Security Secrets (Generate using: python -c "import secrets; print(secrets.token_hex(32))")
# REQUIRED: No fallback in source code. Application will fail fast if missing.
SECRET_KEY=replace_with_64_hex_character_random_string
AES_MASTER_KEY_HEX=replace_with_64_hex_character_random_string
AUDIT_HMAC_KEY_HEX=replace_with_64_hex_character_random_string

# Database Connection (SQLite by default, or PostgreSQL: postgresql://user:pass@localhost:5432/prismarine)
DATABASE_URL=sqlite:///./prismarine.db

# CORS Allowed Origins (Comma-separated list of explicit origins, NO WILDCARDS with credentials)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Privacy & Algorithmic Parameters
K_ANONYMITY_THRESHOLD=5
DP_EPSILON=0.5
DP_MAX_BUDGET_PER_DAY=5.0
OFFICER_WEEKLY_CAPACITY=15
